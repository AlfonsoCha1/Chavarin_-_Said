{
  "name": "chavarin-said-lealtad",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de lealtad para pequeños negocios (nombre provisional: Chavarín & Said)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/migrate.js && node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:reset": "tsx src/seed.ts --reset",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "screens": "tsx scripts/screens.ts",
    "docs": "tsx scripts/build-docs.ts",
    "test:report": "tsx scripts/test-report.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.5",
    "@fontsource-variable/archivo": "^5.3.0",
    "fastify": "^5.12.5",
    "jsqr": "^1.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "marked": "^18.0.14",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}