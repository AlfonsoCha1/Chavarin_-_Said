# Copia este archivo como .env y ajusta los valores. NUNCA subas .env al repositorio.

# Conexión a PostgreSQL (local con docker compose)
DATABASE_URL=postgres://lealtad:lealtad_local@localhost:5432/lealtad
# Base separada para pruebas automáticas (se borra en cada corrida)
TEST_DATABASE_URL=postgres://lealtad:lealtad_local@localhost:5432/lealtad_test

PORT=3000
HOST=0.0.0.0
# URL pública con la que se generan los QR (en Render: https://<tu-servicio>.onrender.com)
PUBLIC_BASE_URL=http://localhost:3000

# Modo demostración: muestra aviso, cuentas demo, buzón simulado y botón de reinicio
DEMO_MODE=true
# Si la base está vacía al arrancar, carga los negocios ficticios
SEED_DEMO_ON_EMPTY=true

# Usa SSL para la base (en Render/Neon normalmente true)
DATABASE_SSL=false

# Mensajería (SMS/WhatsApp/correo). Solo existe el adaptador "simulated".
MESSAGING_PROVIDER=simulated

# Wallet. Solo existe el adaptador "simulated". Google/Apple quedan pendientes de credenciales.
WALLET_PROVIDER=simulated

# Despertador interno (solo para Render gratis). Con KEEPALIVE_ENABLED=true usa RENDER_EXTERNAL_URL/api/health.
# También puedes fijar la URL a mano con KEEPALIVE_URL. Vacío/false = desactivado.
KEEPALIVE_ENABLED=false
KEEPALIVE_URL=
KEEPALIVE_MINUTES=10
# Horario en hora CDMX en que se mantiene despierto (ej. 8-22). Vacío = todo el día.
KEEPALIVE_HOURS=8-22
